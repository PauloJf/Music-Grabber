# Music Grabber: local run config. Copy to `.env` (gitignored) and edit; never commit
# real values. Every variable is also valid in docker-compose.yml.

MUSIC_DIR=/path/to/music
DB_PATH=./data/music_grabber.db
LOG_LEVEL=INFO

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8099/callback
WATCH_PLAYLISTS=

DEEZER_ARL=
PROVIDER_ORDER=deezer,ytdlp
OUTPUT_FORMAT=mp3-128

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Library index: filesystem (default) or opensubsonic (BPM Tagger's Subsonic API, or Navidrome)
LIBRARY_INDEX=filesystem
# LIBRARY_URL=http://bpm-tagger:5000
# LIBRARY_API_KEY=

# Analysis: none (default) | intake | api
ANALYSIS=none
# INTAKE_DIR=/path/to/music/Music-raw

# Post-import hooks (off by default): mediarium, navidrome
# POST_IMPORT_HOOKS=mediarium
# MEDIARIUM_URL=
# MEDIARIUM_API_KEY=
